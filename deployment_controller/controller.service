[Unit]
Description=Regional model deployment controller
After=network-online.target
Wants=network-online.target
[Service]
Type=simple
User=model-deployment
WorkingDirectory=/opt/model-deployment
EnvironmentFile=/etc/model-deployment/controller.env
ExecStart=/opt/model-deployment/venv/bin/python -m deployment_controller --config /etc/model-deployment/regions.json watch --region cn-shenzhen/dev
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
UMask=0077
[Install]
WantedBy=multi-user.target
