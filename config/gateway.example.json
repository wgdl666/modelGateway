{
  "database_url": "postgresql://gateway:replace-me@postgres:5432/model_gateway?sslmode=verify-full",
  "listen": ":18580",
  "api_token": "replace-with-a-distinct-api-token",
  "worker_token": "replace-with-a-distinct-worker-token",
  "admin_token": "replace-with-a-distinct-admin-token",
  "backend_token": "replace-with-the-backend-token",
  "backend_cidrs": ["10.0.0.0/8"],
  "backend_ports": ["8001", "8002"],
  "backend_timeout": "120s",
  "poll_interval": "5s",
  "instance_lease": "30s",
  "max_body_bytes": 16777216
}
