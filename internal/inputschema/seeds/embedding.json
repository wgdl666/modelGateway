{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "x-category": "embedding",
  "description": "文本和图片向量；图片仅接受内联 data URL，维度上限按模型登记定义。",
  "required": ["inputs"],
  "additionalProperties": false,
  "properties": {
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {"type": "string", "minLength": 1},
          {
            "type": "object",
            "additionalProperties": false,
            "anyOf": [{"required": ["text"]}, {"required": ["image"]}],
            "properties": {
              "text": {"type": "string", "minLength": 1},
              "image": {"type": "string", "pattern": "^data:image/(png|jpeg|webp);base64,[A-Za-z0-9+/]+={0,2}$"}
            }
          }
        ]
      }
    },
    "prompt": {"type": ["string", "null"]},
    "normalize": {"type": "boolean", "default": true},
    "dim": {"type": ["integer", "null"], "minimum": 64}
  }
}
