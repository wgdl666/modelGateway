{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "outfit_video",
  "description": "试衣视频：一张首帧人物图",
  "x-category": "video_generation",
  "type": "object",
  "properties": {
    "images": {
      "type": "array",
      "description": "试衣视频：一张首帧人物图",
      "items": {
        "type": "object",
        "required": [
          "mime_type",
          "data"
        ],
        "properties": {
          "mime_type": {
            "type": "string",
            "description": "图片 MIME",
            "pattern": "^image/[A-Za-z0-9.+-]+$"
          },
          "data": {
            "type": "string",
            "description": "图片原始字节的 Base64，不含 data URL 前缀",
            "minLength": 1,
            "contentEncoding": "base64"
          }
        },
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 1
    },
    "prompt": {
      "type": "string",
      "description": "视频提示词",
      "minLength": 1
    },
    "transparent_background": {
      "type": "boolean",
      "default": false,
      "description": "返回带透明通道的 WebM 视频"
    },
    "motion_tips": {
      "type": "string",
      "description": "动作说明"
    }
  },
  "required": [
    "images",
    "prompt"
  ],
  "additionalProperties": false,
  "x-experimental-properties": {
    "model": {
      "type": "string",
      "description": "仅实验凭据可覆盖的生成参数"
    },
    "duration": {
      "type": "string",
      "description": "仅实验凭据可覆盖的生成参数",
      "pattern": "^\\s*[+-]?([0-9]+(\\.[0-9]*)?|\\.[0-9]+)([eE][+-]?[0-9]+)?\\s*$"
    },
    "resolution": {
      "type": "string",
      "description": "仅实验凭据可覆盖的生成参数"
    },
    "fps": {
      "type": "string",
      "description": "仅实验凭据可覆盖的生成参数",
      "pattern": "^\\s*\\+?[0-9]*[1-9][0-9]*(\\.0+)?\\s*$"
    },
    "audio": {
      "type": "string",
      "description": "仅实验凭据可覆盖的生成参数",
      "pattern": "^(0|1|[Tt]|[Ff]|[Yy]|[Nn]|[Oo][Nn]|[Oo][Ff][Ff]|[Tt][Rr][Uu][Ee]|[Ff][Aa][Ll][Ss][Ee]|[Yy][Ee][Ss]|[Nn][Oo])$"
    }
  }
}
