{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "garment_extraction",
  "description": "人物拆衣：第一张人物图，第二张可选的人体解析 mask",
  "x-category": "image_generation",
  "type": "object",
  "properties": {
    "images": {
      "type": "array",
      "description": "人物拆衣：第一张人物图，第二张可选的人体解析 mask",
      "items": {
        "type": "object",
        "required": [
          "mime_type",
          "data"
        ],
        "properties": {
          "mime_type": {
            "type": "string",
            "description": "图片 MIME",
            "pattern": "^image/[A-Za-z0-9.+-]+$"
          },
          "data": {
            "type": "string",
            "description": "图片原始字节的 Base64，不含 data URL 前缀",
            "minLength": 1,
            "contentEncoding": "base64"
          }
        },
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 2
    },
    "garment_name": {
      "type": "string",
      "description": "衣物名称",
      "maxLength": 128,
      "pattern": "[^\\t\\n\\v\\f\\r \\x1c-\\x1f\u0085\u00a0\u1680\u2000-\u200a\u2028\u2029\u202f\u205f\u3000]",
      "not": {
        "pattern": "\\x00|[^\\t\\n\\v\\f\\r \\x1c-\\x1f\u0085\u00a0\u1680\u2000-\u200a\u2028\u2029\u202f\u205f\u3000][\\s\\S]*[\\r\\n][\\s\\S]*[^\\t\\n\\v\\f\\r \\x1c-\\x1f\u0085\u00a0\u1680\u2000-\u200a\u2028\u2029\u202f\u205f\u3000]"
      }
    },
    "garment_role": {
      "type": "string",
      "description": "衣物角色",
      "enum": [
        "outfit",
        "shoes",
        "bag",
        "accessory::ear",
        "accessory::head",
        "accessory::hair",
        "accessory::eye",
        "accessory::neck",
        "accessory::chest",
        "accessory::wrist",
        "accessory::hand",
        "accessory::finger",
        "belt",
        "clothing::top/full",
        "clothing::bottom",
        "accessory::other"
      ]
    },
    "bbox": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 4,
      "maxItems": 4
    },
    "bbox_format": {
      "type": "string",
      "description": "bbox 坐标格式",
      "enum": [
        "auto",
        "pixel_xyxy",
        "normalized_xyxy"
      ]
    },
    "bbox_only": {
      "type": "boolean",
      "default": true,
      "description": "默认仅使用裁切图。false 时依次使用原图、裁切图。"
    },
    "parse_labels": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "minProperties": 1
    }
  },
  "required": [
    "images",
    "garment_name"
  ],
  "additionalProperties": false,
  "oneOf": [
    {
      "required": [
        "bbox"
      ],
      "properties": {
        "images": {
          "maxItems": 1
        }
      },
      "not": {
        "required": [
          "parse_labels"
        ]
      }
    },
    {
      "required": [
        "garment_role",
        "parse_labels"
      ],
      "properties": {
        "images": {
          "minItems": 2
        }
      },
      "not": {
        "anyOf": [
          {
            "required": [
              "bbox"
            ]
          },
          {
            "required": [
              "bbox_format"
            ]
          }
        ]
      }
    }
  ],
  "x-experimental-properties": {
    "prompt": {
      "type": "string",
      "description": "仅实验凭据可覆盖的生成参数",
      "maxLength": 4096,
      "pattern": "[^\\t\\n\\v\\f\\r \\x1c-\\x1f\u0085\u00a0\u1680\u2000-\u200a\u2028\u2029\u202f\u205f\u3000]",
      "not": {
        "pattern": "\\x00"
      }
    },
    "use_pe": {
      "type": "string",
      "description": "仅实验凭据可覆盖的生成参数",
      "pattern": "^([Tt][Rr][Uu][Ee]|[Ff][Aa][Ll][Ss][Ee])$"
    }
  }
}
