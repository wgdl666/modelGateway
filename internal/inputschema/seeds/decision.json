{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "decision",
  "description": "图片决策：恰好一张内联图片，预设 task 或用户问题二选一",
  "x-category": "classification",
  "type": "object",
  "properties": {
    "messages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "role"
        ],
        "properties": {
          "role": {
            "type": "string",
            "description": "消息角色"
          },
          "content": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "object"
                }
              }
            ]
          }
        },
        "additionalProperties": true
      }
    },
    "stream": {
      "type": "boolean"
    },
    "max_tokens": {
      "type": "integer",
      "minimum": 1
    },
    "temperature": {
      "type": "number"
    },
    "model_traits": {
      "type": "object",
      "properties": {
        "task": {
          "type": "string",
          "description": "预设任务名称"
        },
        "options": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "messages"
  ],
  "additionalProperties": true
}
